# ─────────────────────────────────────────────────────────────────────────────
# Agent Orchestrator – Environment Variable Reference
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent Identity (REQUIRED) ─────────────────────────────────────────────────

# Unique identifier for this agent in the orchestration chain.
AGENT_ID=agent-alpha

# Human-readable name for this agent.
AGENT_NAME=Agent Alpha

# ── Downstream Agent (for handing off tasks) ──────────────────────────────────

# URL of the next agent in the chain. Leave empty if this is the last agent.
# Example: http://localhost:5101 or https://agent-beta.example.com
DOWNSTREAM_AGENT_URL=http://localhost:5101

# Optional API key to authenticate with the downstream agent.
# DOWNSTREAM_AGENT_API_KEY=secret-key-for-downstream

# Timeout (seconds) for calls to the downstream agent. Default: 120.
# DOWNSTREAM_TIMEOUT_SECONDS=120

# ── Inbound Security ──────────────────────────────────────────────────────────

# Optional API key that upstream agents must provide in X-Agent-Key header.
# If not set, the /api/tasks/receive endpoint is open.
# INBOUND_API_KEY=my-secret-inbound-key

# ── Orchestration Behaviour ───────────────────────────────────────────────────

# When true, after local processing, tasks are automatically sent to the
# downstream agent. Set to false to require explicit handoff via /api/tasks/handoff.
AUTO_HANDOFF=true

# ── Server ────────────────────────────────────────────────────────────────────

# Port this agent listens on.
PORT=5100
