# ─────────────────────────────────────────────────────────────────────────────
# A2A Agent – Environment Variable Reference
# Copy this file to .env and fill in your values.
# Protocol: Agent-to-Agent (A2A) – JSON-RPC 2.0 over HTTP
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent Identity (REQUIRED) ─────────────────────────────────────────────────

# Unique identifier for this agent.
AGENT_ID=agent-alpha

# Human-readable name (published in AgentCard).
AGENT_NAME=Agent Alpha

# Description of what this agent does (published in AgentCard).
AGENT_DESCRIPTION=A general-purpose A2A agent that processes text and delegates to downstream agents.

# Organization name (published in AgentCard).
# AGENT_ORGANIZATION=My Org

# ── Agent Skills (published in AgentCard) ─────────────────────────────────────

# Skills this agent advertises, formatted as "id:description;id:description"
# AGENT_SKILLS=summarize:Summarizes long documents;translate:Translates content between languages

# ── Downstream Agent (A2A handoff) ────────────────────────────────────────────

# URL of the next A2A agent in the chain. Leave empty if this is the last agent.
# The downstream agent must expose POST /a2a and GET /.well-known/agent.json.
DOWNSTREAM_AGENT_URL=http://localhost:5101

# Optional Bearer token to authenticate with the downstream agent.
# DOWNSTREAM_AGENT_API_KEY=secret-bearer-token

# Timeout (seconds) for calls to the downstream agent. Default: 120.
# DOWNSTREAM_TIMEOUT_SECONDS=120

# ── Orchestration Behaviour ───────────────────────────────────────────────────

# When true, after local processing, tasks are automatically sent to the
# downstream agent via A2A message/send. Set to false to act as terminal.
AUTO_HANDOFF=true

# ── Server ────────────────────────────────────────────────────────────────────

# Port this agent listens on.
PORT=5100
