# ─────────────────────────────────────────────────────────────────────────────
# Hosted Agent – Environment Variable Reference
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure AI Foundry Connection (REQUIRED) ────────────────────────────────────

# Your Azure AI Foundry project endpoint.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# The model deployment name to use (e.g. gpt-4o, gpt-4.1, gpt-4o-mini).
MODEL_DEPLOYMENT_NAME=gpt-4o

# ── Authentication ────────────────────────────────────────────────────────────
# The agent uses DefaultAzureCredential, which tries the following in order:
#   1. Environment variables  (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
#   2. Workload Identity / Managed Identity
#   3. Azure CLI (az login)
#
# For service-principal auth, set:
# AZURE_TENANT_ID=<your-tenant-id>
# AZURE_CLIENT_ID=<your-app-id>
# AZURE_CLIENT_SECRET=<your-client-secret>

# ── Agent Behaviour ───────────────────────────────────────────────────────────

# System prompt / instructions given to the agent.
SYSTEM_PROMPT=You are a helpful AI assistant.

# Display name for the agent (used when creating it in Azure AI Foundry).
AGENT_NAME=my-hosted-agent

# Optional: sampling temperature (0.0 – 2.0). Leave blank to use model default.
# AGENT_TEMPERATURE=0.7

# Optional: maximum tokens in the response. Leave blank to use model default.
# AGENT_MAX_TOKENS=1024

# When true, the framework looks for an existing agent with AGENT_NAME and reuses
# it instead of creating a new one. Useful for long-lived deployments.
# AGENT_REUSE_EXISTING=false

# ── Tool Configuration ────────────────────────────────────────────────────────
# Tools are numbered from 1 upward: TOOL_1_*, TOOL_2_*, …
# Scanning stops at the first missing TOOL_N_TYPE.
#
# Supported TOOL_N_TYPE values:
#   bing_grounding      – Bing Grounding Search
#   code_interpreter    – Code Interpreter
#   file_search         – File Search (vector store)
#   azure_ai_search     – Azure AI Search
#   mcp                 – Model Context Protocol server
#   bing_custom_search  – Bing Custom Search
#   sharepoint          – SharePoint grounding
#   fabric              – Microsoft Fabric data agent
#   browser_automation  – Browser Automation

# ── Example: Bing Grounding ───────────────────────────────────────────────────
# TOOL_1_TYPE=bing_grounding
# TOOL_1_CONNECTION=<bing-connection-id>

# ── Example: Code Interpreter (no extra vars needed) ─────────────────────────
# TOOL_1_TYPE=code_interpreter

# ── Example: Azure AI Search ──────────────────────────────────────────────────
# TOOL_1_TYPE=azure_ai_search
# TOOL_1_CONNECTION=<azure-ai-connection-id>
# TOOL_1_INDEX_NAME=my-search-index
# TOOL_1_TOP_K=5
# TOOL_1_QUERY_TYPE=simple          # simple | semantic | vector | vector_simple_hybrid | vector_semantic_hybrid
# TOOL_1_FILTER=category eq 'docs'  # optional OData filter

# ── Example: MCP (Model Context Protocol) server ──────────────────────────────
# TOOL_1_TYPE=mcp
# TOOL_1_NAME=my_mcp_server               # unique label for this MCP server
# TOOL_1_URL=https://mcp.example.com/sse  # MCP SSE endpoint
# TOOL_1_ALLOWED_TOOLS=search,summarize   # comma-separated; empty = allow all
# TOOL_1_REQUIRE_APPROVAL=never           # never (default) | always
# TOOL_1_HEADERS=Authorization=Bearer token123|X-Custom=value  # pipe-separated key=value pairs

# ── Example: Two MCP servers + Bing Grounding ────────────────────────────────
# TOOL_1_TYPE=bing_grounding
# TOOL_1_CONNECTION=<bing-connection-id>
#
# TOOL_2_TYPE=mcp
# TOOL_2_NAME=docs_server
# TOOL_2_URL=https://docs-mcp.example.com/sse
# TOOL_2_REQUIRE_APPROVAL=never
#
# TOOL_3_TYPE=mcp
# TOOL_3_NAME=code_server
# TOOL_3_URL=https://code-mcp.example.com/sse
# TOOL_3_ALLOWED_TOOLS=run_tests,lint
# TOOL_3_HEADERS=X-Api-Key=secret

# ── Example: SharePoint ───────────────────────────────────────────────────────
# TOOL_1_TYPE=sharepoint
# TOOL_1_CONNECTION=<sharepoint-connection-id>

# ── Example: Microsoft Fabric ────────────────────────────────────────────────
# TOOL_1_TYPE=fabric
# TOOL_1_CONNECTION=<fabric-connection-id>

# ── Example: Bing Custom Search ───────────────────────────────────────────────
# TOOL_1_TYPE=bing_custom_search
# TOOL_1_CONNECTION=<bing-custom-connection-id>
# TOOL_1_INSTANCE_NAME=<bing-custom-instance-name>

# ── Example: Browser Automation ───────────────────────────────────────────────
# TOOL_1_TYPE=browser_automation
# TOOL_1_CONNECTION=<browser-automation-connection-id>

# ── API Options ───────────────────────────────────────────────────────────────

# Set to "true" to enable Swagger UI at /swagger
ENABLE_SWAGGER=true
